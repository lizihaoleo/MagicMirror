# LLM API 配置
# Groq API Key (推荐，速度快)
# 获取地址: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# 或者使用通用 LLM API Key
VITE_LLM_API_KEY=your_llm_api_key_here

# LLM 提供商选择 (groq 或 huggingface)
VITE_LLM_PROVIDER=groq

# Hugging Face API 配置 (备选方案)
# 获取地址: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here
VITE_HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Whisper 语音识别模型配置 (可选)
# 默认使用: Xenova/whisper-base
# 其他选项: whisper-tiny, whisper-small, whisper-medium, whisper-large
VITE_WHISPER_MODEL=Xenova/whisper-base
